# Basic-auth gate in front of the Next.js app (MASTERPLAN §6.2).
# Rendered by the image entrypoint with envsubst. NGINX_ENVSUBST_FILTER (set in the Dockerfile
# `gate` stage) restricts substitution to ${UPSTREAM} and ${BASIC_AUTH_HTPASSWD_FILE}, so NGINX
# runtime variables such as $host stay untouched.
# Phase 2 adds limit_req and further hardening.

# Behind Cloud Run TLS is terminated upstream of NGINX, so $scheme is always "http". Keep the
# protocol the client used when the header is present and fall back to $scheme otherwise (local).
map $http_x_forwarded_proto $forwarded_proto {
    default $http_x_forwarded_proto;
    "" $scheme;
}

upstream app {
    server ${UPSTREAM};
    keepalive 16;
}

server {
    listen 8080;
    server_name _;

    server_tokens off;
    client_max_body_size 1m;

    # Non-production environments must never be indexed.
    add_header X-Robots-Tag "noindex, nofollow" always;

    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $forwarded_proto;
    # Credentials stop at the gate.
    proxy_set_header Authorization "";

    # Probes are exempt from auth so Cloud Run and Docker health checks work.
    location = /health {
        auth_basic off;
        proxy_pass http://app;
    }

    location = /ready {
        auth_basic off;
        proxy_pass http://app;
    }

    location / {
        auth_basic "Restricted";
        auth_basic_user_file ${BASIC_AUTH_HTPASSWD_FILE};
        proxy_pass http://app;
    }
}
