{
  "ci": {
    "collect": {
      "startServerCommand": "APP_ENV=production NEXT_PUBLIC_SITE_URL=http://localhost:3100 npm start -- -p 3100",
      "startServerReadyPattern": "Ready",
      "startServerReadyTimeout": 30000,
      "url": ["http://localhost:3100/"],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.95, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "categories:best-practices": [
          "error",
          { "minScore": 1, "aggregationMethod": "median-run" }
        ],
        "categories:seo": ["error", { "minScore": 1, "aggregationMethod": "median-run" }],
        "largest-contentful-paint": [
          "warn",
          { "maxNumericValue": 2500, "aggregationMethod": "median-run" }
        ],
        "total-blocking-time": [
          "warn",
          { "maxNumericValue": 200, "aggregationMethod": "median-run" }
        ],
        "cumulative-layout-shift": [
          "error",
          { "maxNumericValue": 0.05, "aggregationMethod": "median-run" }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
