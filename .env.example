# local | preview | develop | staging | production
APP_ENV=local

# Canonical origin, inlined into the client bundle at build time
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 3000 for the app
PORT=3000

# error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# Contact form rate limit, per IP and per instance
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=600000

# Gate only (docker compose --profile gate). The NGINX gate entrypoint hashes the password at start
# and refuses to start if either value is empty. The username must not contain ":" and the
# password is at most 72 characters. Wrap the password in SINGLE quotes if it contains `$`:
#   BASIC_AUTH_PASSWORD='pa$$word'
BASIC_AUTH_USERNAME=
BASIC_AUTH_PASSWORD=

# Host port for the gate (default 8080)
GATE_PORT=8080
