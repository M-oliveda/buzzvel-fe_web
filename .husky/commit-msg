#!/usr/bin/env sh

# Validate the commit message format (Gitmoji).
# Expected first line: :<shortcode>: <Capitalised message>
# No trailing period, at most 72 characters.
first_line=$(head -n 1 "$1")

# Messages generated by Git itself (GitFlow merges, reverts, autosquash) are allowed as they are.
if echo "$first_line" | grep -qE '^(Merge |Revert "|fixup! |squash! |amend! )'; then
  exit 0
fi

fail() {
  echo "❌ Error: $1"
  echo ""
  echo "Current: $first_line"
  echo "Format:  :<shortcode>: <Capitalised message without a final period>"
  echo "Example: :sparkles: Add carousel component"
  echo "Example: :bug: Fix navigation routing issue"
  echo "Example: :memo: Update README and MASTERPLAN"
  echo "Reference: https://gitmoji.dev/"
  exit 1
}

# Check 1: starts with a gitmoji shortcode followed by a space (e.g. :sparkles: )
echo "$first_line" | grep -qE '^:[a-z][a-z0-9_]*: ' ||
  fail "Commit message must start with a gitmoji shortcode"

# Message part: everything after the shortcode and its space
message=$(echo "$first_line" | sed -E 's/^:[a-z][a-z0-9_]*: //')

# Check 2: first letter after the shortcode is capitalised
echo "$message" | grep -qE '^[A-Z]' ||
  fail "First letter after the shortcode must be capitalised"

# Check 3: no trailing period
echo "$message" | grep -qE '\.$' &&
  fail "Commit message must not end with a period"

# Check 4: first line is at most 72 characters
[ "${#first_line}" -le 72 ] ||
  fail "First line is longer than 72 characters (${#first_line} chars)"

echo "✅ Commit message is valid"
