[
  {
    "name": "keep-most-recent",
    "action": { "type": "Keep" },
    "mostRecentVersions": { "keepCount": 10 }
  },
  {
    "name": "delete-untagged",
    "action": { "type": "Delete" },
    "condition": { "tagState": "untagged", "olderThan": "7d" }
  },
  {
    "name": "delete-previews",
    "action": { "type": "Delete" },
    "condition": { "tagState": "tagged", "tagPrefixes": ["pr-"], "olderThan": "7d" }
  },
  {
    "name": "delete-old",
    "action": { "type": "Delete" },
    "condition": { "tagState": "any", "olderThan": "30d" }
  }
]
